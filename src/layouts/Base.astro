---
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { site } from '../data/site';
import Loader from '../components/Loader.astro';
import Header from '../components/Header.astro';
import Rails from '../components/Rails.astro';
import Footer from '../components/Footer.astro';
import '../styles/tokens.css';
import '../styles/engine.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image = '/og.png' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImage = new URL(image, Astro.site ?? site.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: fullTitle,
  description,
  url: canonical,
  isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
  about: {
    '@type': 'Movie',
    name: site.film.name,
    dateCreated: String(site.film.year),
    director: { '@type': 'Person', name: site.film.director },
  },
};
---
<!doctype html>
<html lang="en" transition:animate="none" data-tone-l="void" data-tone-r="dust">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#060708" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="preload" href="/fonts/archivo-100_900-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/plex-mono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      document.documentElement.classList.add('js');
      try { if (sessionStorage.getItem('loader-seen')) document.documentElement.classList.add('no-loader'); } catch (e) {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div id="gl" transition:persist="gl" aria-hidden="true"></div>
    <div id="curtain" transition:persist="curtain" aria-hidden="true"><div class="curtain__panel"></div></div>
    <Loader />
    <Header />
    <Rails />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Analytics />
    <SpeedInsights />
    <script>
      import { start } from '../engine/astro';
      import { setupMotion } from '../motion/setup';
      start(setupMotion);
    </script>
  </body>
</html>
