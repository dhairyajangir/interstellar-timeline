---
import Base from '../layouts/Base.astro';
import Art from '../components/Art.astro';
import ClockStrip from '../components/ClockStrip.astro';
import Cta from '../components/Cta.astro';
import Photo from '../components/Photo.astro';
import { photos, size, type Photo as PhotoData } from '../data/photos';
import { chapters } from '../data/site';

// Plain <img> attributes for layered images that don't need a Photo frame.
const img = (p: PhotoData, sizes: string) => {
  const s = size(p);
  return {
    src: `/img/${p.name}-${s.widths[0]}.webp`,
    srcset: s.widths.map((w) => `/img/${p.name}-${w}.webp ${w}w`).join(', '),
    sizes, width: s.w, height: s.h, loading: 'lazy' as const, decoding: 'async' as const,
  };
};
// Through the wormhole, in order. Keys drive src/motion/setup.ts (wormholePassage).
const passage = [
  { key: 'sphere', label: 'A sphere, not a hole', photo: photos.wormholeSphere },
  { key: 'lensed', label: 'Falling in', photo: photos.wormholeLensed },
  { key: 'tunnel', label: 'The throat', photo: photos.wormholeTunnel },
  { key: 'throat', label: 'The Milky Way bent around it', photo: photos.wormholeThroat },
  { key: 'far', label: 'Another galaxy', photo: photos.wormholeFar },
];
// Falling into Gargantua, in order. Keys drive src/motion/setup.ts (fallSequence).
const fall = [
  { key: 'approach', label: 'Approach', photo: photos.blackhole },
  { key: 'disk', label: 'Through the disk', photo: photos.plungeDisk },
  { key: 'horizon', label: 'The sky folds over', photo: photos.plungeHorizon },
  { key: 'ring', label: 'Past the horizon', photo: photos.plungeRing },
  { key: 'tess', label: 'The tesseract', photo: photos.tesseract },
];

const [earth, nasa, wormhole, miller, mann, gargantua, murph, station] = chapters;
const nn = (n: number) => String(n).padStart(2, '0');
const width = (w: number) => `--wdth:${w}`;
const signals = [
  { name: 'Miller', note: 'A water world in a tight orbit around Gargantua.' },
  { name: 'Edmunds', note: 'Farther out from the black hole, and quiet about the details.' },
  { name: 'Mann', note: 'Ice and rock, with the most hopeful data of the three.' },
];
---
<Base>
  <!-- HERO: the two worlds, split. -->
  <section class="hero" data-tone="split" aria-labelledby="hero-title">
    <div class="hero__dust" aria-hidden="true" data-tone="dust"></div>
    <div class="hero__sky">
      <Photo photo={photos.saturn} frame="bleed" caption={false} reveal={false} parallax={false} eager sizes="(min-width: 768px) 50vw, 100vw" class="hero__saturn" />
      <div class="hero__ring" data-spin="90" aria-hidden="true"><Art kind="endurance" /></div>
    </div>
    <p class="hero__meta" data-reveal="fade" data-intro data-delay="0.5">
      <span><cite>Interstellar</cite> (2014), in the order it happens</span>
      <span>Cooper, on the Endurance</span>
    </p>
    <h1 id="hero-title" class="hero__title">
      <span class="hero__one" data-dilate>One trip.</span>
      <span class="hero__two" data-dilate>Two clocks.</span>
    </h1>
    <div class="hero__aside">
      <p class="hero__who" data-reveal="fade" data-intro data-delay="0.6">Murph, on Earth, age 10</p>
      <p class="hero__lede" data-split="lines" data-intro data-delay="0.35">
        A father leaves to find humanity a new home. His daughter stays behind. Gravity makes his hours
        worth her years, so this timeline keeps a clock for each of them, side by side.
      </p>
      <div data-reveal="up" data-intro data-delay="0.6"><Cta href="#earth" label="Start at the farm" /></div>
    </div>
  </section>

  <!-- 01 EARTH: asymmetric pair on dust. -->
  <section id="earth" class="ch ch--earth" data-chapter="0" data-tone="dust" aria-labelledby="t-earth">
    <Photo photo={photos.dustStorm} class="ch__art ch__art--farm" sizes="(min-width: 768px) 45vw, 100vw" />
    <div class="ch__text">
      <p class="ch__meta"><span class="ch__n">{nn(earth.n)}</span>{earth.place}</p>
      <h2 id="t-earth" class="ch__title" style={width(earth.wdth)} data-split="lines">{earth.title}</h2>
      <p class="ch__lede">{earth.lede}</p>
      {earth.body.map((p) => <p>{p}</p>)}
      <ClockStrip {...earth.clockNote} />
    </div>
  </section>

  <!-- 02 NASA: index of signals and the two plans. -->
  <section id="nasa" class="ch ch--nasa" data-chapter="1" data-tone="dust" aria-labelledby="t-nasa">
    <div class="ch__text ch__text--wide">
      <p class="ch__meta"><span class="ch__n">{nn(nasa.n)}</span>{nasa.place}</p>
      <h2 id="t-nasa" class="ch__title" style={width(nasa.wdth)} data-split="lines">{nasa.title}</h2>
      <p class="ch__lede">{nasa.lede}</p>
    </div>
    <div class="nasa__cols">
      <div class="nasa__story">
        <p>{nasa.body[0]}</p>
        <p>{nasa.body[1]}</p>
      </div>
      <div class="nasa__signals">
        <h3 class="nasa__label">Three signals still say come</h3>
        <ol class="signals">
          {signals.map((s) => (
            <li class="signals__row" data-reveal="up"><span class="signals__name">{s.name}</span><span class="signals__note">{s.note}</span></li>
          ))}
        </ol>
      </div>
    </div>
    <div class="plans">
      <p class="plans__a"><strong>Plan A.</strong> Solve gravity and lift everyone off Earth.</p>
      <p class="plans__b"><strong>Plan B.</strong> Frozen embryos, a new world, a fresh start without the people at home.</p>
    </div>
    <div class="nasa__leave">
      <p class="ch__lede">{nasa.body[3]}</p>
      <ClockStrip {...nasa.clockNote} />
    </div>
    <Photo photo={photos.earthLimb} frame="bleed" class="nasa__limb" sizes="100vw" parallax={0.12} />
  </section>

  <!-- 03 WORMHOLE: full-bleed sky. -->
  <section id="wormhole" class="ch ch--wormhole" data-chapter="2" data-tone="void" aria-labelledby="t-wormhole">
    <!-- The passage: a sphere made from real Hubble light, then through it and out. -->
    <div class="fall fall--left" data-passage>
      {passage.map((f) => (
        <figure class={`fall__layer fall__layer--${f.key}`} data-fall-layer={f.key} data-caption={f.label} data-credit={f.photo.credit}>
          <img {...img(f.photo, '100vw')} alt={f.photo.alt} />
          {f.key === 'sphere' && <div class="wh__ring" data-approach aria-hidden="true"><Art kind="endurance" /></div>}
        </figure>
      ))}
      <p class="fall__caption fall__caption--right" aria-hidden="true"><span data-fall-label>{passage[0].label}</span><span data-fall-credit>{passage[0].photo.credit}</span></p>
    </div>
    <div class="ch__text wh__text">
      <p class="ch__meta"><span class="ch__n">{nn(wormhole.n)}</span>{wormhole.place}</p>
      <h2 id="t-wormhole" class="ch__title" style={width(wormhole.wdth)} data-split="lines">{wormhole.title}</h2>
      <Photo photo={photos.saturnNight} class="wh__saturn" sizes="(min-width: 768px) 40vw, 100vw" />
      <p class="ch__lede">{wormhole.lede}</p>
      <p>{wormhole.body[0]}</p>
      <Photo photo={photos.hubbleLens} class="wh__lens" sizes="(min-width: 768px) 30vw, 100vw" parallax={false} />
      <p>{wormhole.body[1]}</p>
      <ClockStrip {...wormhole.clockNote} />
    </div>
  </section>

  <!-- 04 MILLER: the signature. A sticky stage; the clocks run across its scroll length. -->
  <section id="miller" class="ch ch--miller" data-chapter="3" aria-labelledby="t-miller">
    <div class="miller__track" data-clock-span="sticky" data-tone="split">
      <div class="miller__stage" data-miller>
        <h2 id="t-miller" class="miller__title" style={width(miller.wdth)}>
          <span class="miller__title-l">One hour,</span> <span class="miller__title-r">seven years</span>
        </h2>
        <div class="miller__half miller__half--void" data-tone="void">
          <p class="ch__meta"><span class="ch__n">{nn(miller.n)}</span>{miller.place}</p>
          <div class="dial" aria-hidden="true">
            <svg viewBox="0 0 200 200" fill="none" stroke="currentColor">
              <circle cx="100" cy="100" r="96" stroke-width="1" />
              {Array.from({ length: 60 }, (_, i) => (
                <line x1="100" y1={i % 5 ? 8 : 4} x2="100" y2={i % 5 ? 13 : 18} stroke-width={i % 5 ? 1 : 2} transform={`rotate(${i * 6} 100 100)`} />
              ))}
            </svg>
            <span class="dial__hand dial__hand--hour" data-hand="hour"></span>
            <span class="dial__hand dial__hand--min" data-hand="min"></span>
          </div>
          <p class="miller__read"><span class="miller__label">Cooper, on the surface</span><span class="miller__big" data-stage="hours">0 h 00 m</span></p>
          <div class="miller__wave" data-wave><Art kind="wave" /></div>
        </div>
        <div class="miller__half miller__half--dust" data-tone="dust">
          <p class="miller__read"><span class="miller__label">Earth</span><span class="miller__big" data-stage="year">Year 2</span><span class="miller__age" data-stage="age">Murph is 12</span></p>
          <div class="miller__wave" data-wave><Art kind="wave" /></div>
        </div>
      </div>
    </div>
    <div class="miller__after" data-tone="void">
      <Photo photo={photos.tarsMiller} class="miller__photo" sizes="(min-width: 768px) 35vw, 100vw" />
      <div class="miller__copy">
        <p class="ch__lede">{miller.lede}</p>
        {miller.body.map((p) => <p>{p}</p>)}
        <ClockStrip {...miller.clockNote} />
      </div>
    </div>
  </section>

  <!-- 05 MANN: a statement, set large. -->
  <section id="mann" class="ch ch--mann" data-chapter="4" data-tone="void" aria-labelledby="t-mann">
    <div class="ch__text ch__text--wide">
      <p class="ch__meta"><span class="ch__n">{nn(mann.n)}</span>{mann.place}</p>
      <h2 id="t-mann" class="ch__title" style={width(mann.wdth)} data-split="lines">{mann.title}</h2>
    </div>
    <Photo photo={photos.antarctic} frame="bleed" class="mann__ice" sizes="100vw" parallax={0.12} />
    <p class="mann__statement" data-split="lines">{mann.lede} {mann.body[0]}</p>
    <div class="mann__cols">
      <p>{mann.body[1]}</p>
      <p>{mann.body[2]}</p>
      <div class="mann__ranger" data-spin-scrub><Photo photo={photos.ranger} sizes="(min-width: 768px) 30vw, 100vw" parallax={false} /></div>
    </div>
    <ClockStrip {...mann.clockNote} />
  </section>

  <!-- 06 GARGANTUA: sticky black hole, narrative alongside. -->
  <section id="gargantua" class="ch ch--gargantua" data-chapter="5" data-tone="void" aria-labelledby="t-gargantua">
    <!-- The fall: five real frames, scrubbed by scroll, end in the tesseract corridor. -->
    <div class="garg__stick fall" data-fall>
      {fall.map((f) => (
        <figure class={`fall__layer fall__layer--${f.key}`} data-fall-layer={f.key} data-caption={f.label} data-credit={f.photo.credit}>
          {f.key === 'tess' ? (
            <div class="tess" data-tess>
              {[0, 1, 2, 3, 4].map((k) => (
                <img class="tess__copy" style={`--k:${k}`} {...img(f.photo, '100vw')} alt={k ? '' : f.photo.alt} aria-hidden={k ? 'true' : undefined} />
              ))}
            </div>
          ) : (
            <img {...img(f.photo, '100vw')} alt={f.photo.alt} />
          )}
        </figure>
      ))}
      <p class="fall__caption" aria-hidden="true"><span data-fall-label>Approach</span><span data-fall-credit>{photos.blackhole.credit}</span></p>
    </div>
    <div class="garg__text">
      <p class="ch__meta"><span class="ch__n">{nn(gargantua.n)}</span>{gargantua.place}</p>
      <h2 id="t-gargantua" class="ch__title" style={width(gargantua.wdth)} data-split="lines">{gargantua.title}</h2>
      <p class="ch__lede">{gargantua.lede}</p>
      <p>{gargantua.body[0]}</p>
      <p class="garg__tess">{gargantua.body[1]}</p>
      <p>{gargantua.body[2]}</p>
      <p>{gargantua.body[3]}</p>
      <ClockStrip {...gargantua.clockNote} />
    </div>
  </section>

  <!-- 07 MURPH: poster on dust. -->
  <section id="murph" class="ch ch--murph" data-chapter="6" data-tone="dust" aria-labelledby="t-murph">
    <p class="ch__meta"><span class="ch__n">{nn(murph.n)}</span>{murph.place}</p>
    <h2 id="t-murph" class="murph__title">{murph.title}</h2>
    <Photo photo={photos.dustTown} frame="bleed" caption={false} class="murph__town" sizes="100vw" parallax={0.1} />
    <p class="murph__word" aria-hidden="true">Eureka</p>
    <Art kind="morse" class="murph__morse" />
    <div class="murph__cols">
      <div class="murph__lead">
        <p class="ch__lede">{murph.lede}</p>
        <div class="watch">
          <Photo photo={photos.watch} frame="round" caption={false} parallax={false} sizes="12rem" />
          <svg class="watch__hand" viewBox="0 0 100 100" aria-hidden="true"><line x1="50" y1="56" x2="50" y2="8" stroke="currentColor" stroke-width="1.6" data-morse-hand /><circle cx="50" cy="50" r="2.4" fill="currentColor" /></svg>
          <p class="watch__note">The second hand, ticking EUREKA in Morse: short pause for a dot, long for a dash.</p>
        </div>
      </div>
      <div>
        {murph.body.map((p) => <p>{p}</p>)}
        <ClockStrip {...murph.clockNote} />
      </div>
    </div>
  </section>

  <!-- 08 STATION: finale, the two final readings side by side. -->
  <section id="station" class="ch ch--station" data-chapter="7" data-tone="void" aria-labelledby="t-station">
    <div class="ch__text ch__text--wide">
      <p class="ch__meta"><span class="ch__n">{nn(station.n)}</span>{station.place}</p>
      <h2 id="t-station" class="ch__title" style={width(station.wdth)} data-split="lines">{station.title}</h2>
      <p class="ch__lede">{station.lede}</p>
      {station.body.map((p) => <p>{p}</p>)}
    </div>
    <Photo photo={photos.colony} frame="bleed" class="station__colony" sizes="100vw" parallax={0.14} />
    <div class="final">
      <div class="final__cell final__cell--cooper">
        <p class="final__who">Cooper</p>
        <p class="final__num">124</p>
        <p class="final__note">years old by the calendar. He has lived about 2.7 of them since launch.</p>
      </div>
      <div class="final__cell final__cell--earth">
        <p class="final__who">Murph</p>
        <p class="final__num">≈ 94</p>
        <p class="final__note">years old, if he left at about 40. She was ten when he went.</p>
      </div>
    </div>
    <p class="station__more">The full ledger, with what the film states and what is estimated, is on <a class="link" href="/time/">How the clocks drift</a>.</p>
  </section>
</Base>
