---
import { nav, site } from '../data/site';
const path = Astro.url.pathname;
---
<header class="frame">
  <a class="frame__name dilate" data-ink data-text={site.name} href="/" aria-label={`${site.name}, home`}>
    <span class="dilate__t">{site.name}</span>
  </a>
  <nav class="frame__nav" data-ink aria-label="Main">
    <ul>
      {nav.map((n) => (
        <li>
          <a class="dilate draw" data-text={n.label} href={n.href} aria-current={path === n.href ? 'page' : undefined}>
            <span class="dilate__t">{n.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <button class="frame__sound" type="button" data-sound data-ink aria-pressed="false" hidden>
    <span class="frame__bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span class="frame__sound-t">Sound</span>
  </button>
</header>
