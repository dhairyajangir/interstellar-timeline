---
// First load only: a launch countdown that hands off to the hero's split frame.
---
<div id="loader" role="status" aria-label="Loading">
  <div class="loader__dust" aria-hidden="true"></div>
  <div class="loader__center">
    <span class="loader__count" data-loader-out data-loader-count>T−10</span>
    <div class="loader__bar" data-loader-bar></div>
  </div>
  <div class="loader__corners" aria-hidden="true">
    <span data-loader-out>Cooper, ship clock</span>
    <span data-loader-out>Earth clock</span>
  </div>
</div>
