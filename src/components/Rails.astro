---
// The two clocks. They persist across pages; the driver (src/motion/clocks.ts) writes the readouts.
// Each rail carries its person's face; Murph's swaps to the grown-up one as the Earth clock runs.
const face = (name: string, cls: string) => ({ class: `rail__face ${cls}`, src: `/img/${name}-160.webp`, alt: '', width: 160, height: 160, loading: 'lazy' as const, decoding: 'async' as const });
---
<aside class="rails" aria-label="The two clocks" transition:persist="rails">
  <div class="rail rail--cooper">
    <p class="rail__who" data-ink><span class="rail__faces" aria-hidden="true"><img {...face('face-cooper', '')} /></span><span class="rail__name">Cooper</span><span class="rail__sub">Ship clock</span></p>
    <div class="rail__ruler" aria-hidden="true" data-ink><div class="rail__ticks" data-ticks="ship"></div></div>
    <p class="rail__read" data-ink><span class="sr-only">Time since launch, for Cooper: </span><span data-clock="ship">0 yr 000 d 00 h 00 m</span></p>
  </div>
  <div class="rail rail--earth">
    <p class="rail__who" data-ink><span class="rail__faces" aria-hidden="true"><img {...face('face-murph-young', 'rail__face--young')} /><img {...face('face-murph', 'rail__face--grown')} /></span><span class="rail__name">Murph</span><span class="rail__sub" data-clock="earth-label">Earth clock</span></p>
    <div class="rail__ruler" aria-hidden="true" data-ink><div class="rail__ticks" data-ticks="earth"></div></div>
    <p class="rail__read" data-ink><span class="sr-only">Time since launch, on Earth: </span><span data-clock="earth">Year 0, 00 mo</span><span class="rail__age" data-clock="murph">Murph 10</span></p>
  </div>
</aside>
